# Server Configuration
PORT=5555
NODE_ENV=production

# Logging Configuration
LOG_LEVEL=info

# CORS Configuration - PRODUCTION SECURE
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# File Upload Configuration
MAX_FILE_SIZE=524288000  # 500MB in bytes
OUTPUT_BASE=./uploads
HASH_STORE_FILE=./hashes.json
JOBS_STORE_FILE=./jobs.json

# Processing Configuration
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT=600000  # 10 minutes in milliseconds
ENABLE_HASH_CHECK=true

# Cache Configuration
CACHE_CLEANUP_INTERVAL=86400000  # 24 hours in milliseconds
MAX_CACHE_AGE=604800000  # 7 days in milliseconds

# Il2CppDumper Configuration
IL2CPP_DUMPER_PATH=./Il2CppDumper/Il2CppDumper/bin/Release/net8.0/Il2CppDumper.dll


#cloudflare turnstile
SITE_KEY=0x000000000
SECRET_KEY=0x000000000
