{
  "name": "il2cpp-dumper-server",
  "version": "2.0.0",
  "description": "Free online Unity IL2CPP File Dumper & Decompiler. Extract IL2CPP binaries, metadata, and assemblies without installation. Perfect for game developers and reverse engineers.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "docker:build": "docker build -t il2cpp-dumper-server .",
    "docker:run": "docker run -p 5555:5555 il2cpp-dumper-server",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "clean": "rm -rf uploads/* logs/* hashes.json jobs.json",
    "seo:check": "echo 'SEO optimization complete - check /sitemap.xml and /robots.txt'"
  },
  "keywords": [
    "il2cpp",
    "unity",
    "il2cppdumper",
    "reverse-engineering",
    "game-modding",
    "decompiler",
    "binary-dumper",
    "unity-assemblies",
    "metadata-extraction",
    "game-development-tools",
    "unity-hacking",
    "il2cpp-binary",
    "unity-reverse-engineering",
    "game-analysis",
    "il2cpp-metadata"
  ],
  "author": "Il2CppDumper Team",
  "license": "MIT",
  "dependencies": {
    "archiver": "^5.3.2",
    "axios": "^1.11.0",
    "busboy": "^1.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "resumablejs": "^1.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.4.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+hhttps://github.com/springmusk026/Il2CppDumperWeb.git"
  },
  "bugs": {
    "url": "https://github.com/springmusk026/Il2CppDumperWeb/issues"
  }
}
