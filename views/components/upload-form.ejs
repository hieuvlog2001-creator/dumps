<div class="xl:col-span-2">
    <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-6">
            <i class="fas fa-upload mr-2 text-blue-600"></i>
            Upload Files for Dumping
        </h2>

        <form id="upload-form" class="space-y-6">
            <!-- SO File Upload -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    SO/Binary File (.so, .dll, .dylib)
                </label>
                <div class="file-drop-zone rounded-lg p-6 text-center cursor-pointer" data-file-type="soFile">
                    <i class="fas fa-file-archive text-3xl text-gray-400 mb-2"></i>
                    <p class="text-sm text-gray-600">Drop your SO file here or click to browse</p>
                    <p class="text-xs text-gray-500 mt-1">Max size: <%= Math.round(config.maxFileSize / 1024 / 1024) %>
                            MB</p>
                    <input type="file" name="soFile" accept=".so,.dll,.dylib" class="hidden">
                </div>
                <div class="file-info mt-2 hidden">
                    <div class="flex items-center justify-between p-2 bg-gray-50 rounded">
                        <span class="file-name text-sm font-medium"></span>
                        <button type="button" class="remove-file text-red-600 hover:text-red-800">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Metadata File Upload -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    Metadata File (.dat, .meta, global-metadata.dat)
                </label>
                <div class="file-drop-zone rounded-lg p-6 text-center cursor-pointer" data-file-type="metaFile">
                    <i class="fas fa-file-code text-3xl text-gray-400 mb-2"></i>
                    <p class="text-sm text-gray-600">Drop your metadata file here or click to browse</p>
                    <p class="text-xs text-gray-500 mt-1">Usually named global-metadata.dat</p>
                    <input type="file" name="metaFile" accept=".dat,.meta" class="hidden">
                </div>
                <div class="file-info mt-2 hidden">
                    <div class="flex items-center justify-between p-2 bg-gray-50 rounded">
                        <span class="file-name text-sm font-medium"></span>
                        <button type="button" class="remove-file text-red-600 hover:text-red-800">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- File Validation Results -->
            <div id="validation-results" class="space-y-4 hidden">
                <h3 class="text-sm font-medium text-gray-700">File Validation Results</h3>
                <div id="validation-content" class="space-y-2"></div>
            </div>

            <!-- Cloudflare Turnstile (Invisible Mode) -->
            <div class="hidden">
                <div class="cf-turnstile"
                    data-sitekey="<%= typeof config !== 'undefined' ? config.turnstileSiteKey : '' %>"
                    data-callback="turnstileCallback"
                    data-error-callback="turnstileErrorCallback"
                    data-theme="light"
                    data-size="invisible">
                </div>
            </div>

            <!-- Upload Progress -->
            <div id="upload-progress" class="hidden space-y-4">
                <h4 class="text-sm font-medium text-gray-700">Upload Progress</h4>
                <div class="space-y-2">
                    <div class="flex justify-between text-sm">
                        <span>SO File</span>
                        <span id="so-progress">0%</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div id="so-progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span>Metadata File</span>
                        <span id="meta-progress">0%</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div id="meta-progress-bar" class="bg-green-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="submit-btn"
                class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                <i class="fas fa-play mr-2"></i>
                Start Dumping Process
            </button>
        </form>
    </div>

    <!-- Active Job Progress -->
    <div id="job-progress" class="hidden bg-white rounded-lg shadow-lg p-6 mt-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">
            <i class="fas fa-cog fa-spin mr-2 text-blue-600"></i>
            Processing Job
        </h3>

        <div class="space-y-4">
            <div>
                <div class="flex justify-between text-sm font-medium text-gray-700 mb-1">
                    <span id="progress-label">Preparing...</span>
                    <span id="progress-percent">0%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                    <div id="progress-bar" class="progress-bar bg-blue-600 h-2 rounded-full" style="width: 0%"></div>
                </div>
            </div>

            <div class="bg-gray-50 rounded-lg p-4">
                <div class="flex justify-between items-center mb-2">
                    <h4 class="text-sm font-medium text-gray-700">Process Output</h4>
                    <button id="toggle-log" class="text-xs text-blue-600 hover:text-blue-800">
                        <i class="fas fa-eye"></i> Toggle
                    </button>
                </div>
                <div id="log-output"
                    class="log-output text-xs text-gray-600 max-h-48 overflow-y-auto bg-black text-green-400 p-3 rounded hidden">
                    <div id="log-content"></div>
                </div>
            </div>
        </div>
    </div>
</div>