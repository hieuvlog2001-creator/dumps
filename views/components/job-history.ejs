<!-- Job History Sidebar -->
<div class="xl:col-span-1">
    <div class="bg-white rounded-lg shadow-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-6">
            <i class="fas fa-history mr-2 text-green-600"></i>
            Recent Jobs
        </h2>

        <div id="job-history" class="space-y-4">
            <div class="text-center text-gray-500 py-8">
                <i class="fas fa-clock text-2xl mb-2"></i>
                <p class="text-sm">No recent jobs</p>
            </div>
        </div>

        <button id="load-more-jobs" class="w-full mt-4 text-sm text-blue-600 hover:text-blue-800 py-2 hidden">
            Load More Jobs
        </button>
    </div>

    <!-- System Info -->
    <div class="bg-white rounded-lg shadow-lg p-6 mt-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">System Information</h3>
        <div id="system-info" class="space-y-2 text-sm text-gray-600">
            <div class="flex justify-between">
                <span>Max File Size:</span>
                <span>
                    <%= Math.round(config.maxFileSize / 1024 / 1024) %>MB
                </span>
            </div>
            <div class="flex justify-between">
                <span>Max Concurrent Jobs:</span>
                <span>
                    <%= config.maxConcurrentJobs %>
                </span>
            </div>
            <div class="flex justify-between">
                <span>Server Uptime:</span>
                <span id="server-uptime">-</span>
            </div>
            <div class="flex justify-between">
                <span>Memory Usage:</span>
                <span id="memory-usage">-</span>
            </div>
        </div>
    </div>
</div>