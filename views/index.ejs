<%- contentFor('head') %>
    <style>
        .file-drop-zone {
            border: 2px dashed #cbd5e0;
            transition: all 0.3s ease;
        }
        .file-drop-zone.dragover {
            border-color: #4299e1;
            background-color: #ebf8ff;
        }
        .progress-bar {
            transition: width 0.3s ease;
        }
        .job-card {
            animation: slideIn 0.3s ease-out;
        }
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .log-output {
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 12px;
            line-height: 1.4;
        }
    </style>

<%- contentFor('modals') %>
<%- include('components/modals') %>

<%- contentFor('scripts') %>
<%- include('components/scripts') %>

<%- contentFor('body') %>

<!-- Hero Section -->
<section class="text-center mb-12" aria-labelledby="hero-heading">
    <h2 id="hero-heading" class="text-3xl font-bold text-gray-900 mb-4">
        Free Online Unity IL2CPP File Dumper
                    </h2>
    <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-6">
        Extract and decompile Unity IL2CPP binaries with ease. Upload your SO files and metadata,
        get instant results without installation. Perfect for game developers and reverse engineers.
    </p>
    <div class="flex flex-wrap justify-center gap-4 text-sm text-gray-500">
        <span class="inline-flex items-center">
            <i class="fas fa-check-circle text-green-500 mr-2" aria-hidden="true"></i>
            No Installation Required
        </span>
        <span class="inline-flex items-center">
            <i class="fas fa-shield-alt text-blue-500 mr-2" aria-hidden="true"></i>
            Secure Processing
        </span>
        <span class="inline-flex items-center">
            <i class="fas fa-rocket text-purple-500 mr-2" aria-hidden="true"></i>
            Real-time Results
        </span>
        <span class="inline-flex items-center">
            <i class="fas fa-lock text-red-500 mr-2" aria-hidden="true"></i>
            Bot Protection
        </span>
                            </div>
</section>

<!-- Main Application -->
<section aria-labelledby="app-heading">
    <h3 id="app-heading" class="sr-only">Il2CppDumper Application</h3>

    <%- include('components/system-status') %>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
        <%- include('components/upload-form') %>
        <%- include('components/job-history') %>
                        </div>
</section>

